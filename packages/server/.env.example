# Copy this file to .env in this directory for local development.
# The server reads it automatically on startup (via `dotenv/config`).

# Required. 32 bytes, base64 or hex encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored secret permanently unrecoverable --
# back it up somewhere safe, separate from the database file.
ENVPULSE_MASTER_KEY=

# Optional. Path to the SQLite database file.
ENVPULSE_DB_PATH=./envpulse.db

# Optional. Defaults shown.
PORT=8787
HOST=0.0.0.0
